{
  "schemaVersion": 1,
  "id": "fractured_reflections",
  "version": "${version}",
  "name": "Fractured Reflections",
  "description": "A 1 vs 4 asymmetrical horror game set in a procedurally generated gothic mansion that exists simultaneously in the Main World and an inverted Mirror Dimension.",
  "authors": ["revjve"],
  "contact": {
    "sources": "https://github.com/revjve/fractured-reflections"
  },
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "main": ["com.revjve.fractured.FracturedReflections"],
    "client": ["com.revjve.fractured.client.FracturedReflectionsClient"],
    "voicechat": ["com.revjve.fractured.compat.voicechat.FRVoicechatPlugin"],
    "lambdynamiclights": ["com.revjve.fractured.compat.lambdynlights.FRDynamicLights"]
  },
  "mixins": [
    "fractured_reflections.mixins.json",
    {
      "config": "fractured_reflections.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.14.21",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": ">=0.83.0"
  },
  "recommends": {
    "imm_ptl_core": "*",
    "lambdynlights": "*",
    "voicechat": "*"
  }
}
